DATABASE_URL="postgresql://username:password@your-production-host:5432/movie_db?sslmode=require"

# Example for Neon (free Postgres):
# DATABASE_URL="postgresql://user:pass@ep-cool-project.us-east-2.aws.neon.tech/movie_db?sslmode=require"

# Example for Supabase:
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[project-ref].supabase.co:5432/postgres"

# IMPORTANT: 
# - Replace with your actual production DB credentials
# - NEVER commit .env with real secrets
# - Set this in Vercel/Railway dashboard Environment Variables
# - Local: Copy to .env with your local postgres://localhost:5432/movie_db
